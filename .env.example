# ContextCov configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Only check GENERATION and the semantic (ARCH_SEMANTIC) checks call an LLM.
# Static and architectural checks run offline, so enforcing an existing mapping
# needs no credentials at all.

# ---------------------------------------------------------------------------
# Required: default provider/model for every stage, as provider:model[:temperature]
# ---------------------------------------------------------------------------
DEFAULT_LLM=openai:gpt-4o:0.2

# ---------------------------------------------------------------------------
# Provider credentials - fill in whichever provider DEFAULT_LLM names
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...
# Optional. Defaults to https://api.openai.com/v1; set only for a proxy/gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Optional. Defaults to 2024-10-21.
# AZURE_OPENAI_API_VERSION=2024-10-21

# Gemini
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama (local)
# OLLAMA_URL=http://localhost:11434/v1

# Anthropic (used by the claudecode provider, which runs the local `claude` CLI)
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Optional: override the model for an individual pipeline stage.
# Each falls back to DEFAULT_LLM when unset.
# ---------------------------------------------------------------------------
# COMPRESSION_LLM=openai:gpt-4o-mini:0.0
# ROUTER_LLM=openai:gpt-4o:0.0
# STATIC_CHECK_LLM=openai:gpt-4o:0.0
# PROCESS_CHECK_LLM=openai:gpt-4o:0.0
# ARCH_DETERMINISTIC_LLM=openai:gpt-4o:0.0
# ARCH_SEMANTIC_LLM=openai:gpt-4o:0.0

# Cache LLM responses across runs
# LLM_CACHE_ENABLE=1
